---
import { type Lang, org, person, projects, SITE_URL } from '../../content/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const th = lang === 'th';
const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, '');
---

<section id="s7" data-scene="7" data-h="460" data-m="420" data-screen-label="07 End credits" style="position:relative;height:320vh">
<div data-stage style="position:sticky;top:0;height:100vh;overflow:hidden;background:#F2EFE8">
  <div data-roll style="position:relative;padding:16vh 4vw;display:flex;flex-direction:column;gap:9vh;text-align:center">
    <div style="display:flex;flex-direction:column;gap:12px;align-items:center">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase"><span data-l={lang}>{th ? 'ภาพยนตร์ของ' : 'A film by'}</span></div>
      <h2 style="margin:0;font-weight:700;font-size:clamp(32px,5vw,80px);letter-spacing:-.02em;line-height:1">{person.name.en}</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:22px;align-items:center;max-width:640px;margin:0 auto">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase"><span data-l={lang}>{th ? 'รับบท' : 'Starring as'}</span></div>
      <div style="display:flex;flex-direction:column;gap:6px;align-items:center">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase"><span data-l={lang}>{th ? 'ปัจจุบัน' : 'Now'}</span></div>
        <div style="font-weight:700;font-size:clamp(22px,2.6vw,38px);line-height:1.15">Founder, CEO - Planthia Tech</div>
        <p style="margin:6px 0 0;font-size:clamp(14px,1.15vw,17px);line-height:1.6;text-wrap:pretty"><span data-l={lang}>{th ? 'นำวิสัยทัศน์ การวางกรอบโปรดักต์ และทิศทางการส่งมอบงาน ให้กิจการที่มุ่งสร้างโซลูชันเทคโนโลยีเพื่อความยั่งยืน ที่โตไปพร้อมการดำเนินธุรกิจจริงได้' : 'I lead the vision, product framing, and delivery direction for a venture focused on sustainable technology solutions that can scale with real business operations.'}</span></p>
        <ul style="margin:10px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:clamp(13px,1.05vw,16px);line-height:1.55">
          <li><span data-l={lang}>{th ? 'กำหนดทิศทางโปรดักต์ และกำหนดว่าจะสร้างอะไร ตั้งแต่กลยุทธ์ไปจนถึงการลงมือทำ' : 'Set the product direction and shape what gets built from strategy through execution.'}</span></li>
          <li><span data-l={lang}>{th ? 'แปลงไอเดียด้านความยั่งยืนให้เป็นระบบที่ทีมใช้งานได้จริง' : 'Translate sustainability-minded ideas into practical systems that teams can actually run.'}</span></li>
          <li><span data-l={lang}>{th ? 'บาลานซ์การสร้างบริษัท การดูแลด้านเทคนิค และการส่งมอบโปรดักต์ โดยไม่เสียจังหวะ' : 'Balance company building, technical oversight, and product delivery without losing momentum.'}</span></li>
        </ul>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;align-items:center">
        <div style="font-weight:700;font-size:clamp(22px,2.6vw,38px);line-height:1.15">Founder - Eukron</div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.06em"><span data-l={lang}>{th ? 'สตาร์ทอัพเทคผู้สร้าง MunMuang และ Tenerie' : 'Tech startup behind MunMuang and Tenerie'}</span></div>
      </div>
      <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 32px;width:100%;margin-top:10px">
        <div style="grid-column:1/-1;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase"><span data-l={lang}>{th ? 'ก่อนหน้านี้' : 'Previously'}</span></div>
        <dl style="display:contents">
          <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Itone</dt><dd style="text-align:left;font-weight:700;font-size:clamp(16px,1.5vw,22px)">Application Development Analyst</dd>
          <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Gsource</dt><dd style="text-align:left;font-weight:700;font-size:clamp(16px,1.5vw,22px)">Part-time Full-stack Developer</dd>
        </dl>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 32px;max-width:760px;margin:0 auto;width:100%">
      <div style="grid-column:1/-1;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:8px"><span data-l={lang}>{th ? 'นักแสดง' : 'Cast'}</span></div>
      <dl style="display:contents">
        <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Native apps</dt><dd style="text-align:left;font-weight:700;font-size:clamp(17px,1.6vw,24px)">Swift · macOS</dd>
        <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Chat platform</dt><dd style="text-align:left;font-weight:700;font-size:clamp(17px,1.6vw,24px)">LINE</dd>
        <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Front of house</dt><dd style="text-align:left;font-weight:700;font-size:clamp(17px,1.6vw,24px)">Web apps</dd>
        <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Backstage</dt><dd style="text-align:left;font-weight:700;font-size:clamp(17px,1.6vw,24px)">Backend services</dd>
        <dt style="text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;text-transform:uppercase;letter-spacing:.08em">Set &amp; rigging</dt><dd style="text-align:left;font-weight:700;font-size:clamp(17px,1.6vw,24px)">Cloud infrastructure</dd>
      </dl>
    </div>
    <div style="display:flex;flex-direction:column;gap:12px;align-items:center">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase"><span data-l={lang}>{th ? 'อำนวยการผลิต' : 'Production'}</span></div>
      <div style="font-weight:700;font-size:clamp(24px,3vw,44px);line-height:1.1">{org.name}</div>
      <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.08em;text-transform:uppercase"><span data-l={lang}>{th ? 'ประเทศไทย' : 'Thailand'}</span></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px;align-items:center">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase"><span data-l={lang}>{th ? 'ผลงานในเรื่อง' : 'Featuring'}</span></div>
      {projects.map((p) => <a href={p.url} target="_blank" rel="noopener" style="font-weight:700;font-size:clamp(20px,2.2vw,32px);text-decoration:none">{p.name}</a>)}
    </div>
    <div style="display:flex;flex-direction:column;gap:12px;align-items:center;font-family:'IBM Plex Mono',monospace;font-size:clamp(13px,1.1vw,16px)">
      <div style="font-size:12px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:6px"><span data-l={lang}>{th ? 'ติดตาม' : 'Find me'}</span></div>
      {person.email.map((e) => <a href={`mailto:${e}`}>{e}</a>)}
      <a href={SITE_URL} target="_blank" rel="noopener">{bare(SITE_URL)}</a>
      {person.sameAs.map((u) => <a href={u} target="_blank" rel="noopener">{bare(u)}</a>)}
    </div>
  </div>
</div>
</section>
