---
import type { Lang } from '../../../content/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const th = lang === 'th';
---

<div data-ink style="position:absolute;inset:0;mix-blend-mode:multiply">
      <svg viewBox="0 0 100 100" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible">
        <defs><pattern id="htM" width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><circle cx="1.3" cy="1.3" r=".85" fill="#7C3AED"></circle></pattern></defs>
        <circle data-ht cx="72" cy="30" r="25" fill="url(#htM)"></circle>
        <rect x="32" y="41" width="62" height="17" rx="8.5" fill="#7C3AED"></rect>
        <rect x="85" y="51" width="9" height="7" fill="#7C3AED"></rect>
      </svg>
      <div style="position:absolute;left:32%;top:41%;width:62%;height:17%;display:grid;place-items:center;color:#F2EFE8">
        <span data-messy style="grid-area:1/1;font-family:'IBM Plex Mono',monospace;font-size:3.6cqw;opacity:0">scan0001 (2).pdf</span>
        <span data-clean style="grid-area:1/1;font-weight:700;font-size:4.2cqw"><span data-l={lang}>{th ? 'สัญญา-เซ็นแล้ว.pdf' : 'contract-signed.pdf'}</span></span>
      </div>
    </div>
    <div data-key style="position:absolute;inset:0;mix-blend-mode:multiply">
      <svg viewBox="0 0 100 100" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible">
        <rect x="6" y="14" width="62" height="17" rx="8.5" fill="none" stroke="#111" stroke-width="1"></rect>
        <rect x="6" y="24" width="8" height="7" fill="#111"></rect>
        <rect x="6" y="68" width="62" height="17" rx="8.5" fill="none" stroke="#111" stroke-width="1"></rect>
        <rect x="6" y="78" width="8" height="7" fill="#111"></rect>
      </svg>
      <div style="position:absolute;left:6%;top:14%;width:62%;height:17%;display:grid;place-items:center">
        <span data-messy style="grid-area:1/1;font-family:'IBM Plex Mono',monospace;font-size:3.6cqw;opacity:0">IMG_20260311_0934.JPG</span>
        <span data-clean style="grid-area:1/1;font-weight:700;font-size:4.2cqw"><span data-l={lang}>{th ? 'ใบเสร็จ-มีนาคม.jpg' : 'receipt-march.jpg'}</span></span>
      </div>
      <div style="position:absolute;left:6%;top:68%;width:62%;height:17%;display:grid;place-items:center">
        <span data-messy style="grid-area:1/1;font-family:'IBM Plex Mono',monospace;font-size:3.6cqw;opacity:0">final_v3_REAL(1).docx</span>
        <span data-clean style="grid-area:1/1;font-weight:700;font-size:4.2cqw"><span data-l={lang}>{th ? 'ใบเสนอราคา-v3.docx' : 'proposal-v3.docx'}</span></span>
      </div>
    </div>
