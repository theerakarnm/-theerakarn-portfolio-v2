---
import type { Lang } from '../content/site';
import Chrome from './Chrome.astro';
import Contact from './scenes/Contact.astro';
import Credits from './scenes/Credits.astro';
import How from './scenes/How.astro';
import Opening from './scenes/Opening.astro';
import Premise from './scenes/Premise.astro';
import Reel from './scenes/Reel.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div data-root style="position:relative;font-family:'Anuphan',sans-serif;color:#111;background:#F2EFE8">
  <Chrome lang={lang} />
  <main>
    <Opening lang={lang} />
    <Premise lang={lang} />
    <Reel id="tenerie" index={2} lang={lang} />
    <Reel id="munmuang" index={3} lang={lang} />
    <Reel id="buddy" index={4} lang={lang} />
    <Reel id="friday" index={5} lang={lang} />
    <How lang={lang} />
    <Credits lang={lang} />
    <Contact lang={lang} />
  </main>
</div>

<script>
  import '../scripts/showreel';
</script>
